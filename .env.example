# Blackbox Jury local configuration. Copy to .env (git-ignored) and fill in.
# Placeholders only. Never commit real values.

# Required. Bearer token for /api/v1 routes (>= 32 chars). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BBJ_API_TOKEN=

# Optional
BBJ_API_ACTOR=local-admin
BBJ_ENV=dev
BBJ_HOST=127.0.0.1
BBJ_PORT=8000
BBJ_LOG_LEVEL=INFO
