# Blackbox Jury local configuration. Copy to .env (git-ignored) and fill in.
# Placeholders only. Never commit real values.

# Required. Bearer token for /api/v1 routes (>= 32 chars). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BBJ_API_TOKEN=

# Optional
BBJ_API_ACTOR=local-admin
BBJ_ENV=dev
BBJ_HOST=127.0.0.1
BBJ_PORT=8000
BBJ_LOG_LEVEL=INFO

# Sandbox. Images are built locally with `make images` and never pulled at run time.
BBJ_GATEWAY_IMAGE=bbj-gateway:0.1.0
# JSON list. Only these target images may ever be executed.
BBJ_ALLOWED_TARGET_IMAGES=["bbj-refundbot:0.1.0"]
BBJ_EXEC_TIMEOUT_S=30
BBJ_DOCKER_TIMEOUT_S=20
